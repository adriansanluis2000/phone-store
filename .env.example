# Copy to .env.local, which git ignores, to try the smart search locally (ADR 0011)

# Claude API key, read only by the AI search function on the server
ANTHROPIC_API_KEY=

# Model of the AI search, claude-haiku-5-5 when empty
AI_SEARCH_MODEL=

# Shows the smart search in the browser
VITE_AI_SEARCH_ENABLED=true
